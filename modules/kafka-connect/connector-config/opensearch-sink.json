{
  "name": "opensearch-sink",
  "config": {
    "connector.class": "io.aiven.kafka.connect.opensearch.OpenSearchSinkConnector",
    "tasks.max": "1",
    "topics": "ufb.tracks,ufb.releases,ufb.artists,ufb.labels",
    "connection.url": "https://vpc-ufb-production-4h7sifyorjglxisr5y2r7xpt6a.eu-west-2.es.amazonaws.com:443",
    "aws.region": "eu-west-2",
    "aws.service.signing.name": "es",
    "key.ignore": "false",
    "schema.ignore": "true",
    "behavior.on.null.values": "delete",
    "behavior.on.malformed.documents": "warn",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "connection.timeout.ms": "10000",
    "read.timeout.ms": "30000",

    "predicates": "IsTracksTopic,IsReleasesTopic,IsArtistsTopic,IsLabelsTopic",
    "predicates.IsTracksTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.IsTracksTopic.pattern": "ufb\\.tracks",
    "predicates.IsReleasesTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.IsReleasesTopic.pattern": "ufb\\.releases",
    "predicates.IsArtistsTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.IsArtistsTopic.pattern": "ufb\\.artists",
    "predicates.IsLabelsTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.IsLabelsTopic.pattern": "ufb\\.labels",

    "transforms": "ExtractData,InsertTypeTracks,InsertTypeReleases,InsertTypeArtists,InsertTypeLabels",
    "transforms.ExtractData.type": "org.apache.kafka.connect.transforms.ExtractField$Value",
    "transforms.ExtractData.field": "data",
    "transforms.InsertTypeTracks.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.InsertTypeTracks.static.field": "type",
    "transforms.InsertTypeTracks.static.value": "tracks",
    "transforms.InsertTypeTracks.predicate": "IsTracksTopic",
    "transforms.InsertTypeReleases.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.InsertTypeReleases.static.field": "type",
    "transforms.InsertTypeReleases.static.value": "releases",
    "transforms.InsertTypeReleases.predicate": "IsReleasesTopic",
    "transforms.InsertTypeArtists.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.InsertTypeArtists.static.field": "type",
    "transforms.InsertTypeArtists.static.value": "artists",
    "transforms.InsertTypeArtists.predicate": "IsArtistsTopic",
    "transforms.InsertTypeLabels.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.InsertTypeLabels.static.field": "type",
    "transforms.InsertTypeLabels.static.value": "labels",
    "transforms.InsertTypeLabels.predicate": "IsLabelsTopic"
  }
}
